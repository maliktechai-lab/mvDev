# ── Build stage ───────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Copy manifests first so npm ci is cached when source changes
COPY package.json package-lock.json ./
RUN npm ci --frozen-lockfile

COPY . .

# Inject the API base URL so the built assets hit Nginx → backend
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=${VITE_API_URL}

RUN npm run build

# ── Production stage ──────────────────────────────────────────────────────
FROM nginx:1.25-alpine

# Copy built SPA assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Nginx config: serve SPA, forward /api and /heatmaps to the backend container.
# This config is used when frontend-blink is run WITHOUT the shared nginx proxy
# (e.g. docker-compose --profile blink-standalone). When the main nginx container
# is present it proxies everything, so the frontend only needs the SPA catch-all.
RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    gzip on;\n\
    gzip_types text/css application/javascript application/json image/svg+xml;\n\
\n\
    # SPA routing — send all non-file requests to index.html\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
\n\
    # Long-term cache for immutable hashed assets\n\
    location ~* \\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:80/ > /dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
