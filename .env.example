# ── Application ──────────────────────────────────────────
APP_NAME=DeepGuard
APP_ENV=development          # development | production
DEBUG=true
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# ── Database ─────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=deepguard
POSTGRES_USER=deepguard_user
POSTGRES_PASSWORD=deepguard_password
DATABASE_URL=postgresql+asyncpg://deepguard_user:deepguard_password@postgres:5432/deepguard

# ── Redis / Celery ────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── JWT Auth ─────────────────────────────────────────────
JWT_SECRET_KEY=change-this-jwt-secret-key-too
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── File Storage ─────────────────────────────────────────
UPLOAD_DIR=./uploads
HEATMAP_DIR=./heatmaps
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=500
MAX_AUDIO_SIZE_MB=50

# ── ML Models ────────────────────────────────────────────
MODEL_DIR=../ml/checkpoints
IMAGE_MODEL_PATH=../ml/checkpoints/deepguard_image.pth
VIDEO_MODEL_PATH=../ml/checkpoints/deepguard_video.pth
AUDIO_MODEL_PATH=../ml/checkpoints/deepguard_audio.pth
DEVICE=cpu                   # cpu | cuda

# ── Inference ────────────────────────────────────────────
IMAGE_CONFIDENCE_THRESHOLD=0.5
VIDEO_FRAMES_PER_SEC=1
AUDIO_CHUNK_DURATION_SEC=3
