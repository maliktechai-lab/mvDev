# ════════════════════════════════════════════════════════════════════════════
# DeepGuard — environment configuration template
#
# Copy this file to .env and fill in real values before running.
# The .env file is listed in .gitignore and must NEVER be committed.
#
# PRODUCTION CHECKLIST
# ─────────────────────
# The application refuses to start in production (APP_ENV=production) if any
# of the following conditions are detected:
#   • SECRET_KEY or JWT_SECRET_KEY still matches a known placeholder value.
#   • DEBUG=true.
#   • POSTGRES_PASSWORD is a known weak value ("deepguard_password", "password" …).
#   • ALLOWED_ORIGINS contains "localhost" or "127.0.0.1".
#   • FLOWER_BASIC_AUTH is still "admin:changeme".
#
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_hex(64))"
# ════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────
APP_NAME=DeepGuard
APP_ENV=development          # development | production
DEBUG=true                   # Set to false in production (enforced automatically)
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
# Production: set ALLOWED_ORIGINS to your exact frontend domain(s)
# e.g. ALLOWED_ORIGINS=https://app.deepguard.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# ── Database ─────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=deepguard
POSTGRES_USER=deepguard_user
# CHANGE THIS — a known placeholder will cause startup failure in production.
POSTGRES_PASSWORD=deepguard_password
DATABASE_URL=postgresql+asyncpg://deepguard_user:deepguard_password@postgres:5432/deepguard

# ── Redis / Celery ────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── JWT Auth ─────────────────────────────────────────────────────────────
# CHANGE THIS — a known placeholder will cause startup failure in production.
JWT_SECRET_KEY=change-this-jwt-secret-key-too
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Celery Flower monitoring ──────────────────────────────────────────────
# Format: user:password
# Access Flower via SSH tunnel in production — it is NOT exposed publicly.
#   ssh -L 5555:localhost:5555 your-server
# CHANGE THIS — the default will cause startup failure in production.
FLOWER_BASIC_AUTH=admin:changeme

# ── File Storage ─────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
HEATMAP_DIR=./heatmaps
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=500
MAX_AUDIO_SIZE_MB=50

# ── ML Models ────────────────────────────────────────────────────────────
# Docker: the volume mount in docker-compose.yml maps ./ml/checkpoints → /app/checkpoints
#   IMAGE_MODEL_PATH=/app/checkpoints/deepguard_image.pth
#
# Local dev (running uvicorn from repo root / backend/):
#   Symlink or copy ml/checkpoints → backend/checkpoints, then:
#   IMAGE_MODEL_PATH=./checkpoints/deepguard_image.pth
#
# See README — "Model Checkpoints" section for training instructions.
MODEL_DIR=/app/checkpoints
IMAGE_MODEL_PATH=/app/checkpoints/deepguard_image.pth
VIDEO_MODEL_PATH=/app/checkpoints/deepguard_video.pth
AUDIO_MODEL_PATH=/app/checkpoints/deepguard_audio.pth
DEVICE=cpu                   # cpu | cuda (cuda requires nvidia-container-toolkit)

# ── Inference ────────────────────────────────────────────────────────────
IMAGE_CONFIDENCE_THRESHOLD=0.5
VIDEO_FRAMES_PER_SEC=1
AUDIO_CHUNK_DURATION_SEC=3
